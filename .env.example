# ===================================
# AI 服务配置（至少配置一个）
# ===================================

# Google Gemini（推荐，免费额度充足）
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL=gemini-3.1-pro-preview
# 可选：Gemini API 基础 URL（一般无需修改）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# 可选：Gemini 推理等级（LOW/MEDIUM/HIGH）
# GEMINI_THINKING_LEVEL=HIGH

# DeepSeek（推荐，性价比高）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# 可选：DeepSeek API 基础 URL（一般无需修改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（可选）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# 可选：OpenAI API 基础 URL（一般无需修改）
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude（可选）
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# 可选：Anthropic API 基础 URL（一般无需修改）
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# AIHubMix（可选，多模型聚合）
# 获取地址: https://aihubmix.com/token
AIHUBMIX_KEY=your_aihubmix_key_here
AIHUBMIX_MODEL=gemini-2.5-flash
# 可选：AIHubMix API 基础 URL（一般无需修改）
# AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# Anspire（可选，多模型聚合）
# 获取地址: https://www.anspire.cn
# 支持多个 Key（逗号分隔）
ANSPIRE_API_KEYS=your_anspire_api_key_here
ANSPIRE_MODEL=gemini-2.5-flash
# 可选：Anspire API 基础 URL（一般无需修改）
# ANSPIRE_BASE_URL=https://api.anspire.cn/v1

# LiteLLM（可选，统一模型网关）
# 支持通过 OpenAI 兼容接口连接 LiteLLM Proxy，也支持使用 LiteLLM 配置文件路由。
# 代理模式示例：
# LITELLM_API_KEY=sk-your-litellm-key
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_MODEL=stock-analysis
# 可选：fallback 模型（逗号分隔）
# LITELLM_FALLBACK_MODELS=stock-analysis-backup,gpt-4o-mini
# 可选：直接读取 LiteLLM YAML 配置文件
# LITELLM_CONFIG=config/litellm.yaml
# GitHub Actions 中也可将 YAML 全文写入 Secret/Variable `LITELLM_CONFIG_YAML`
LITELLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_MODEL=
LITELLM_FALLBACK_MODELS=
LITELLM_CONFIG=
LITELLM_CONFIG_YAML=

# ===================================
# 搜索服务配置（推荐至少配置一个）
# ===================================

# 博查搜索（推荐，中文搜索效果好）
# 获取地址: https://open.bochaai.com/
# 支持多个 Key（逗号分隔，自动轮换）
BOCHA_API_KEYS=your_bocha_api_key_here

# Tavily 搜索（可选）
# 获取地址: https://app.tavily.com/home
# 支持多个 Key（逗号分隔）
TAVILY_API_KEYS=your_tavily_api_key_here

# SerpAPI（可选）
# 获取地址: https://serpapi.com/manage-api-key
# 支持多个 Key（逗号分隔）
SERPAPI_API_KEYS=your_serpapi_api_key_here

# MiniMax 搜索（可选）
# 获取地址: https://platform.minimaxi.com/
# 支持多个 Key（逗号分隔）
MINIMAX_API_KEYS=your_minimax_api_key_here

# Brave Search（可选）
# 获取地址: https://api-dashboard.search.brave.com/app/keys
# 支持多个 Key（逗号分隔）
BRAVE_API_KEYS=your_brave_api_key_here

# SearXNG（可选，自托管搜索）
# 支持多个实例 URL（逗号分隔）
SEARXNG_BASE_URLS=http://localhost:8080
# 是否允许回退到公共 SearXNG 实例（默认 true）
SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# ===================================
# 行情数据源配置（可选）
# ===================================

# Tushare Pro（A 股推荐）
# 获取地址: https://tushare.pro/user/token
TUSHARE_TOKEN=your_tushare_token_here

# TickFlow（可选）
TICKFLOW_API_KEY=your_tickflow_api_key_here

# Finnhub（美股实时行情可选）
# 获取地址: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage（美股可选）
# 获取地址: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Twelve Data（美股可选）
# 获取地址: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Polygon.io（美股可选）
# 获取地址: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# LongPort / Longbridge（美股/港股/A股可选）
# 推荐使用 OAuth Token Cache 方式；旧版 API Key 方式也兼容。
# 文档: https://open.longbridge.com/docs
# OAuth 方式
LONGBRIDGE_OAUTH_CLIENT_ID=
LONGBRIDGE_OAUTH_CLIENT_SECRET=
# 将 LongPort SDK 生成的 token cache 文件整体 base64 后填入此处
LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# 旧版 Legacy API Key 方式
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Futu OpenD（可选）
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_MARKET=US
FUTU_SECURITY_FIRM=FUTUSECURITIES
FUTU_TRADE_ENV=SIMULATE
FUTU_TRADE_PWD_MD5=
FUTU_MAX_POSITION_PCT=0.10
FUTU_REQUIRE_APPROVAL=true

# ===================================
# 通知配置（至少配置一种）
# ===================================

# 邮件通知（推荐）
EMAIL_SENDER=your_email@gmail.com
# Gmail 需使用“应用专用密码”，不是登录密码
EMAIL_PASSWORD=your_app_password
# 多个收件人用逗号分隔；留空则默认发给发件人自己
EMAIL_RECEIVERS=recipient1@example.com,recipient2@example.com
EMAIL_SENDER_NAME=股票智能分析

# PushPlus（微信推送）
# 获取地址: https://www.pushplus.plus/
PUSHPLUS_TOKEN=your_pushplus_token_here

# Server酱3（微信推送）
# 获取地址: https://sc3.ft07.com/
SERVERCHAN3_SENDKEY=your_serverchan3_sendkey_here

# 企业微信机器人
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# 钉钉机器人
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token
DINGTALK_SECRET=your_dingtalk_secret_here

# 飞书机器人
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_token
FEISHU_WEBHOOK_SECRET=your_feishu_secret_here
# 飞书应用模式（与 Webhook 二选一）
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_CHAT_ID=your_chat_id

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# ntfy
NTFY_URL=https://ntfy.sh/your_topic
NTFY_TOKEN=your_ntfy_token_here

# Gotify
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=your_gotify_token_here

# AstrBot
ASTRBOT_URL=http://localhost:6185
ASTRBOT_TOKEN=your_astrbot_token_here

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
# 或 Bot Token + Channel ID
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_ID=C0123456789

# ===================================
# 通知路由与限流（可选）
# ===================================
# 报告类通知允许的渠道，逗号分隔；留空表示所有已配置渠道
NOTIFICATION_REPORT_CHANNELS=
# 警报类通知允许的渠道
NOTIFICATION_ALERT_CHANNELS=
# 系统错误通知允许的渠道
NOTIFICATION_SYSTEM_ERROR_CHANNELS=
# 去重 TTL（秒），0 表示关闭
NOTIFICATION_DEDUP_TTL_SECONDS=0
# 同类通知冷却时间（秒），0 表示关闭
NOTIFICATION_COOLDOWN_SECONDS=0
# 静默时段，例如 23:00-07:00
NOTIFICATION_QUIET_HOURS=
# 通知时区
NOTIFICATION_TIMEZONE=Asia/Shanghai
# 最低通知严重级别：debug/info/warning/error/critical
NOTIFICATION_MIN_SEVERITY=info
# 是否启用每日摘要模式
NOTIFICATION_DAILY_DIGEST_ENABLED=false

# ===================================
# 自选股配置
# ===================================
# 格式：代码:名称，多个用逗号分隔
# A股示例：600519:贵州茅台,000858:五粮液
# 美股示例：AAPL:苹果,MSFT:微软,NVDA:英伟达
STOCK_LIST=600519:贵州茅台,000858:五粮液

# ===================================
# 市场复盘配置
# ===================================
# 市场区域：cn / us
MARKET_REVIEW_REGION=cn
# 颜色风格：red_up / green_up
MARKET_REVIEW_COLOR_SCHEME=red_up
# 是否启用市场复盘
MARKET_REVIEW_ENABLED=true

# ===================================
# 报告配置
# ===================================
# 报告类型：full / summary
REPORT_TYPE=full
# 报告语言：zh / en；留空自动判断
REPORT_LANGUAGE=
# 是否显示 LLM 模型名称
REPORT_SHOW_LLM_MODEL=true
# 是否只输出摘要
REPORT_SUMMARY_ONLY=false
# 报告完整性检查
REPORT_INTEGRITY_ENABLED=true
REPORT_INTEGRITY_RETRY=1
# 历史对比最近 N 次
REPORT_HISTORY_COMPARE_N=3
# 是否合并最终邮件通知（GitHub Actions 中由 V6 统一发送）
MERGE_EMAIL_NOTIFICATION=true

# ===================================
# 分析运行配置
# ===================================
# 单股分析之间延迟秒数
ANALYSIS_DELAY=0
# 最大并发数
MAX_WORKERS=2
# 交易日检查
TRADING_DAY_CHECK_ENABLED=true
# 是否单股逐条通知
SINGLE_STOCK_NOTIFY=false
# 筹码分布（云端接口不稳定，默认关闭）
ENABLE_CHIP_DISTRIBUTION=false

# ===================================
# 实时行情配置
# ===================================
# 实时数据源优先级（逗号分隔）
REALTIME_SOURCE_PRIORITY=finnhub,yfinance,tencent,akshare_sina,efinance,akshare_em
# YFinance 优先级；0 表示按 REALTIME_SOURCE_PRIORITY
YFINANCE_PRIORITY=0
# 预取实时行情
PREFETCH_REALTIME_QUOTES=true
# 启用实时行情
ENABLE_REALTIME_QUOTE=true
# 启用实时技术指标
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
# 实时行情复用缓存 TTL 秒数
REALTIME_QUOTE_REUSE_TTL_SECONDS=30

# ===================================
# 基本面分析
# ===================================
ENABLE_FUNDAMENTAL_PIPELINE=true

# ===================================
# 新闻与搜索策略
# ===================================
# short / balanced / deep
NEWS_STRATEGY_PROFILE=short
# SerpAPI 最新新闻查询超时
SERPAPI_FRESH_TIMEOUT_SECONDS=12
# SerpAPI 深度分析查询超时
SERPAPI_ANALYTICAL_TIMEOUT_SECONDS=20
# 新闻最大年龄（天）
NEWS_MAX_AGE_DAYS=3

# ===================================
# LiteLLM 结构化输出优化
# ===================================
# 流式返回空内容时快速 fallback
LITELLM_FAST_FAILOVER_ON_EMPTY_STREAM=true
# 结构化 JSON 模式
LITELLM_JSON_OBJECT_MODE=true

# ===================================
# 市场状态与预测上下文
# ===================================
MARKET_REGIME_ENABLED=true
PREDICTION_CONTEXT_ENABLED=true
PREDICTION_CONTEXT_CACHE_TTL_SECONDS=900
DAILY_MARKET_CONTEXT_ENABLED=true

# ===================================
# 历史快照与自动回测
# ===================================
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# V6 Daily Intelligence（可选）
# ===================================
# 是否启用 V6 免费公开数据增强（SEC/FRED）
V6_FREE_SOURCE_ENRICHMENT=true
# V6 预测指标达到可衡量状态前的最小成熟样本数
V6_DAILY_MIN_SAMPLES=50
# 每次 V6 最多扫描多少条历史分析记录
V6_DAILY_SCAN_LIMIT=5000
# 是否发送最终 V6 综合日报
V6_DAILY_NOTIFY=true
# SEC EDGAR User-Agent，建议包含应用名与联系邮箱
SEC_USER_AGENT=your-app-name contact@example.com
# FRED API Key（免费申请: https://fred.stlouisfed.org/docs/api/api_key.html）
FRED_API_KEY=your_fred_api_key_here

# ===================================
# V6.2 Accuracy Lab（美股研究层，可选）
# ===================================
# BUY_SETUP 执行回测往返成本，单位 bps；默认 10 = 0.10%
V6_ACCURACY_LAB_COST_BPS=10
# BUY_SETUP 执行回测最大未来交易日持仓窗口
V6_ACCURACY_LAB_MAX_HOLDING_BARS=20
# Challenger 进入人工晋级研究所需最小“非重叠”成熟样本数
V6_ACCURACY_LAB_PROMOTION_MIN_SAMPLES=100

# ===================================
# 回测配置（可选）
# ===================================
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# 日志配置
# ===================================
LOG_LEVEL=INFO

# ===================================
# Web 服务配置
# ===================================
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Web API Token（生产环境务必修改）
WEB_API_TOKEN=change-me
# 是否允许跨域；生产环境建议限制
WEB_CORS_ORIGINS=http://localhost:5173

# ===================================
# Docker / 部署配置
# ===================================
TZ=Asia/Shanghai

# ===================================
# Desktop 应用配置
# ===================================
# Desktop 后端端口；0 表示自动分配
DESKTOP_BACKEND_PORT=0
# Desktop 自动更新渠道
DESKTOP_UPDATE_CHANNEL=stable
